# Envisioner, Inc. — envisionerinc.com

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Send http:// to https:// once, permanently.
  #
  # Two conditions, not one. Where TLS is terminated ahead of Apache the
  # request arrives as plain http with X-Forwarded-Proto: https, and a rule
  # testing only %{HTTPS} would redirect a request that is already secure —
  # straight into a loop. Redirect only when neither says https.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

DirectoryIndex index.html

<IfModule mod_mime.c>
  # Older Apache builds on shared hosting do not know webp and offer the
  # hero as a download instead of painting it.
  AddType image/webp .webp
</IfModule>
